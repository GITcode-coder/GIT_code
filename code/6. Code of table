# Table 1: performance measures and 95% CIs are based on 500 independent simulation replicates
library(Metrics)
R <- 500

run_one_sim <- function(seed){
  set.seed(seed)
  x_list <- list()
  x_list[[1]] <- matrix(1, nrow = n_patients, ncol = K0)
  x_list[[1]][1:(n_patients/2),] <- 0
  names(x_list) <- c("Covariate1")
  beta_list <- list()
  beta_list[[1]] <- beta_true
  names(beta_list) <- c("Covariate1")
  assign("x_list", x_list, envir = .GlobalEnv)
  assign("beta_list", beta_list, envir = .GlobalEnv)
  tp <- 0:K0
  tmax <- K0
  n_sim <- n_patients
  discrete_chains <- list()
  for (i in 1:n_sim) {
    start_state <- sample(c("PFS", "PD"), 1, prob = c(2/3, 1/3))
    cont_traj <- sim_one_patient(i, params, tmax, start_state)
    states <- sur_traj(cont_traj, tp)
    discrete_chains[[i]] <- data.frame(PatientID = i, Time = tp, State = states)
  }
  wide_data <- do.call(rbind, lapply(discrete_chains, function(df) {
    df$State_Num <- as.numeric(factor(df$State,
                                      levels = c("PFS", "PD", "Death"),
                                      labels = c(1, 2, 3)))
    df_wide <- as.data.frame(t(df$State_Num))
    names(df_wide) <- paste0("t_", tp)
    df_wide
  }))
  wide_data <- as.data.frame(wide_data)
  obser <- round(c(1:K)/K*K0)
  wide_data_1 <- wide_data[,c(1,obser+1)]
  C1 <- data_sur_extract(wide_data_1, x_list, q)
  data_sur <- C1
  HR_cox <- beta_of_HR_cox(data_sur,M)
  HR_TV <- beta_of_HR_TV(data_sur,M,K)
  HR_TV <- HR_TV[,-13]
  HR_rcs <- beta_of_HR_rcs(data_sur,M,K)
  HR_rcs <- HR_rcs[,-13]
  beta_post <- beta_of_bcmc(data_sur,M,K,s0,lamstar)
  bcmc <- beta_post[1:K,c(1:3,6:8,11:13,16:18)]
  n0 <- 200
  bcmc_wei <- beta_fit_wei(bcmc,M,K,n0)
  bcmc_lin <- beta_fit_lin(bcmc,M,K,n0)
  bcmc_splin_1 <- beta_fit_splin(bcmc,M,K,n0,3)
  bcmc_splin_2 <- beta_fit_splin(bcmc,M,K,n0,4)
  bcmc_splin_3 <- beta_fit_splin(bcmc,M,K,n0,5)
  bcmc_splin_4 <- beta_fit_splin(bcmc,M,K,n0,6)
  bcmc_fit_all <- list()
  aic_all_0 <- 0
  for(m in 1:M){
    col <- (m-1)*3+1
    y0 <- bcmc[,col]
    bcmc_all <- list(bcmc_wei[[m]],bcmc_lin[[m]],bcmc_splin_1[[m]],bcmc_splin_2[[m]],bcmc_splin_3[[m]],bcmc_splin_4[[m]])
    aic_all <- c(0)
    for(mod in 1:6){
      n_parm <- c(2,2,4,5,6,7)
      y1 <- as.vector(bcmc_all[[mod]][,1])
      aic0 <- zbic(y0,log(y1),n_parm[mod])
      aic_all <- c(aic_all,aic0)
    }
    aic_all_0 <- rbind(aic_all_0,c(aic_all[-1],which.min(aic_all[-1])))
    best_mod <- which.min(aic_all[-1])
    bcmc_fit_all[[m]] <- bcmc_all[[best_mod]]
  }
  data_all <- list()
  for(m in 1:M){
    y_cox <- cbind(rep(as.numeric(HR_cox[m,1]),K),rep(as.numeric(HR_cox[m,2]),K),rep(as.numeric(HR_cox[m,3]),K))
    colnames(y_cox) <- c("cox","cox_lwr","cox_upr")
    col <- (m-1)*3+1
    y_tv <- cbind(HR_TV[,col],HR_TV[,col+1],HR_TV[,col+2])
    colnames(y_tv) <- c("tv","tv_lwr","tv_upr")
    y_rcs <- cbind(HR_rcs[,col],HR_rcs[,col+1],HR_rcs[,col+2])
    colnames(y_rcs) <- c("rcs","rcs_lwr","rcs_upr")
    y_true <- exp(beta_true[m,round(c(1:K)/K*K0)])
    x <- data.frame(x = 1:K)
    data_all[[m]] <- cbind(x,y_true,bcmc_fit_all[[m]],y_cox,y_tv,y_rcs)
  }
  data_all
}

bias_sim <- array(NA, dim = c(R, M, 4))
mae_sim <- array(NA, dim = c(R, M, 4))
mse_sim <- array(NA, dim = c(R, M, 4))
smape_sim <- array(NA, dim = c(R, M, 4))
ci_cov_sim <- array(NA, dim = c(R, M, 4))
ci_wide_sim <- array(NA, dim = c(R, M, 4))

for(r in 1:R){
  data_all_r <- run_one_sim(r)
  for(m in 1:M){
    dat <- data_all_r[[m]][,c(2,3,6,9,12)]
    colnames(dat) <- c("true","bcmc","cox","tv","rcs")
    ci_95 <- data_all_r[[m]][,c(4,5,7,8,10,11,13,14)]
    est_list <- list(dat$cox, dat$tv, dat$rcs, dat$bcmc)
    lwr_list <- list(ci_95[,3], ci_95[,5], ci_95[,7], ci_95[,1])
    upr_list <- list(ci_95[,4], ci_95[,6], ci_95[,8], ci_95[,2])
    for(p_method in 1:4){
      est <- est_list[[p_method]]
      true <- dat$true
      bias_sim[r,m,p_method] <- mean(true-est,na.rm=TRUE)
      mae_sim[r,m,p_method] <- mean(abs(true-est),na.rm=TRUE)
      mse_sim[r,m,p_method] <- mean((true-est)^2,na.rm=TRUE)
      smape_sim[r,m,p_method] <- mean(smape(true,est)*100,na.rm=TRUE)
      ci_cov_sim[r,m,p_method] <- mean(lwr_list[[p_method]] <= true & true <= upr_list[[p_method]],na.rm=TRUE)
      ci_wide_sim[r,m,p_method] <- mean(abs(upr_list[[p_method]]-lwr_list[[p_method]]),na.rm=TRUE)
    }
  }
}

bias <- 0
bias_5 <- 0
mae <- 0
mse <- 0
smape <- 0
mae_5 <- 0
mse_5 <- 0
ci_cov <- 0
ci_wide <- 0
for(m in 1:M){
  for(p_method in 1:4){
    bias <- c(bias,mean(bias_sim[,m,p_method],na.rm=TRUE))
    bias_5 <- c(bias_5,t_test_ci_bias(bias_sim[,m,p_method],rep(0,R)))
    mae <- c(mae,mean(mae_sim[,m,p_method],na.rm=TRUE))
    mse <- c(mse,mean(mse_sim[,m,p_method],na.rm=TRUE))
    smape <- c(smape,paste0(round(mean(smape_sim[,m,p_method],na.rm=TRUE),2),"%"))
    mae_5 <- c(mae_5,t_test_ci_mae(mae_sim[,m,p_method],rep(0,R)))
    mse_5 <- c(mse_5,t_test_ci_mse(mse_sim[,m,p_method],rep(0,R)))
    ci_cov <- c(ci_cov,paste0(round(mean(ci_cov_sim[,m,p_method],na.rm=TRUE)*100,2),"%"))
    ci_wide <- c(ci_wide,round(mean(ci_wide_sim[,m,p_method],na.rm=TRUE),2))
  }
}
rmse <- sqrt(mse)
out <- cbind(bias,bias_5,mae,mae_5,mse,mse_5,rmse,smape,ci_cov,ci_wide)[-1,]
write.csv(out,paste0("~/Desktop/BCMC_result/",sta[stasi],"/table_1_z.csv"))
end.rcode-->


