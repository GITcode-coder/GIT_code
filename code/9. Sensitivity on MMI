summary_stats <- function(data, name) {
  cat("\n", name, ":\n", sep = "")
  cat("  Dimensions:", nrow(data), "rows x", ncol(data), "columns\n")
  cat("  Column 1 (init_state):", paste(unique(data[,1]), collapse = ", "), "\n")
  # Count deaths at final time
  final_col <- ncol(data)
  death_count <- sum(data[, final_col] == 3, na.rm = TRUE)
  cat("  Deaths at final time (t=K):", death_count, 
      "(", round(death_count/nrow(data)*100, 1), "%)\n")
}

