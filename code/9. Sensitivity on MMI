#' Sample transition time from Weibull hazard with covariate effects
#' 
#' @param kappa Weibull shape parameter
#' @param lambda Weibull scale parameter  
#' @param beta_row_index Row index in beta matrix (1..4)
#' @param patient_id Patient index
#' @param entry_time Time entering current state
#' @param tmax Maximum follow-up time
#' @param q Number of covariates
#' @param beta_list List of beta matrices
#' @param x_list List of covariate matrices
#' @param lag_idx Lag index for higher-order model (1 = current state)
#' @param hist_states Historical states for higher-order dependence (vector of length psi)
#' @param state_mapping Named vector for state to numeric conversion
sample_tran_time <- function(kappa, lambda, beta_row_index, patient_id, entry_time, 
                             tmax, q, beta_list, x_list, 
                             lag_idx = 1, hist_states = NULL, state_mapping = NULL) {
  
  U <- runif(1)
  if (U <= 0) return(Inf)
  if (U >= 1) return(entry_time)
  
  entry_time_int <- ceiling(entry_time)
  if (entry_time_int < entry_time) entry_time_int <- entry_time_int + 1
  
  max_search_time <- min(tmax, entry_time_int + 1000)
  
  for (t in entry_time_int:max_search_time) {
    cumulative_hazard <- 0
    
    for (s in entry_time_int:t) {
      s_state <- s - entry_time
      if (s_state <= 0) next
      
      # Baseline hazard: h0(t) = lambda * kappa * t^(kappa-1)
      h0 <- lambda * kappa * (s_state)^(kappa - 1)
      
      # Covariate effect
      time_idx <- min(max(1, s - entry_time_int + 1), K)
      eta <- 0
      for (j in 1:q) {
        x_j <- x_list[[j]][patient_id, time_idx]
        beta_j <- beta_list[[j]][beta_row_index, time_idx]
        eta <- eta + x_j * beta_j
      }
      
      cumulative_hazard <- cumulative_hazard + h0 * exp(eta)
    }
    
    if (exp(-cumulative_hazard) < U) {
      return(t)
    }
  }
  
  return(max_search_time)
}

#' Simulate one patient trajectory with higher-order Markov dependence
#' 
#' @param patient_id Patient index
#' @param params Transition path parameters
#' @param tmax Maximum follow-up time
#' @param start_state Initial state
#' @param psi Order of Markov chain (MMI target)
#' @param phi Weight vector for each lag (length = psi, sum to 1)
sim_one_patient_ho <- function(patient_id, params, tmax = K, start_state, 
                               psi = 1, phi = NULL) {
  
  # Default: first-order Markov (phi_1 = 1)
  if (is.null(phi)) {
    phi <- rep(0, psi)
    phi[1] <- 1
  }
  if (length(phi) != psi) {
    stop("Length of phi must equal psi")
  }
  if (abs(sum(phi) - 1) > 1e-10) {
    stop("phi must sum to 1")
  }
  
  # State mapping for numerical encoding
  state_map <- c("PFS" = 1, "PD" = 2, "Death" = 3)
  state_names <- c("PFS", "PD", "Death")
  
  # Initialize trajectory
  current_state <- start_state
  entry_time <- 0
  traj <- data.frame(time = entry_time, state = current_state, event = "Enter")
  
  # Store history of states (for higher-order dependence)
  state_history <- c(current_state)  # most recent first
  
  while (current_state != "Death" & entry_time < tmax) {
    # Find possible transitions from current state
    possible_trans <- Filter(function(x) x[1] == current_state, params)
    if (length(possible_trans) == 0) break
    
    # For each possible transition, compute weighted hazard across lags
    trans_times <- numeric(length(possible_trans))
    
    for (j in 1:length(possible_trans)) {
      trans <- possible_trans[[j]]
      kappa <- as.numeric(trans[3])
      lambda <- as.numeric(trans[4])
      beta_row_index <- as.numeric(trans[5])
      
      # Weighted sampling across lags (higher-order Markov)
      # For each lag l, sample a potential transition time
      lag_times <- numeric(psi)
      lag_weights <- numeric(psi)
      
      for (l in 1:psi) {
        # Determine the state at lag l
        # state_history[1] = current state (lag 1)
        # state_history[l] = state at lag l
        if (l <= length(state_history)) {
          lag_state <- state_history[l]
        } else {
          # If history insufficient, use current state
          lag_state <- current_state
        }
        
        # Sample transition time using the state at lag l as the "current" state
        # Note: The hazard is evaluated from the lag state, but the clock starts 
        # from the actual entry_time into the current state.
        # For simplicity, we use the same entry_time but the hazard is evaluated
        # as if the process were in the lag state.
        # A more rigorous approach would track entry times per state.
        # Here we approximate by using the same entry_time.
        
        t_sample <- sample_tran_time(
          kappa = kappa, 
          lambda = lambda, 
          beta_row_index = beta_row_index, 
          patient_id = patient_id, 
          entry_time = entry_time, 
          tmax = tmax, 
          q = q, 
          beta_list = beta_list, 
          x_list = x_list,
          lag_idx = l,
          hist_states = state_history[1:min(l, length(state_history))],
          state_mapping = state_map
        )
        
        lag_times[l] <- t_sample
        lag_weights[l] <- phi[l]
      }
      
      # Weighted average of transition times (using harmonic mean or min)
      # Following Method S2: the transition intensity is the weighted average
      # of lag-specific intensities. We approximate by taking the weighted 
      # minimum of the sampled times (earliest event across lags).
      # A more exact approach would use competing risks with weighted hazards.
      trans_times[j] <- weighted.mean(lag_times, w = lag_weights)
    }
    
    # Find the earliest transition
    next_time <- min(trans_times)
    if (next_time >= tmax) break
    
    idx <- which.min(trans_times)
    next_state <- possible_trans[[idx]][2]
    
    traj <- rbind(traj,
                  data.frame(time = next_time, 
                             state = next_state, 
                             event = "Transfer"))
    
    # Update history: prepend new state (most recent first)
    state_history <- c(next_state, state_history)
    # Keep only psi most recent states
    if (length(state_history) > psi) {
      state_history <- state_history[1:psi]
    }
    
    current_state <- next_state
    entry_time <- next_time
    
    if (nrow(traj) > 30) break
  }
  
  # Censoring
  if (current_state != "Death" & entry_time < tmax) {
    traj <- rbind(traj,
                  data.frame(time = tmax,
                             state = current_state,
                             event = "Censored"))
  }
  
  return(traj)
}

#' Convert continuous trajectory to discrete-time state chain
sur_traj <- function(traj, tp) {
  states <- rep(NA, length(tp))
  for (i in 1:length(tp)) {
    t <- tp[i]
    idx <- which(traj$time <= t)
    if (length(idx) > 0) {
      states[i] <- traj$state[max(idx)]
    }
  }
  return(states)
}

