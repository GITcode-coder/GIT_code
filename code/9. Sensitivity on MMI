#' Simulate data for a given MMI target
#' 
#' @param psi Target MMI (1, 2, 3, or 4)
#' @param phi Weight vector for each lag (length = psi)
#' @param n_patients Number of patients
#' @param K Number of time points
#' @param tp Time points
#' @param params Transition parameters
#' @param prob_start Probability of starting in PFS vs PD
#' @param seed Random seed
#' @return A data frame with n_patients rows and (K+1) columns:
#'         Column 1: initial state, Columns 2:(K+1): states at each time point
simulate_mmi_scenario <- function(psi, phi, n_patients = 50, K = 260, 
                                  tp = seq(0, K, 1), params, 
                                  prob_start = c(2/3, 1/3), seed = 123) {
  
  set.seed(seed)
  
  cat("Simulating MMI =", psi, "with phi =", paste(round(phi, 3), collapse = ", "), "\n")
  start_time <- Sys.time()
  
  discrete_chains <- list()
  pb <- txtProgressBar(min = 0, max = n_patients, style = 3)
  
  for (i in 1:n_patients) {
    # Sample initial state
    start_state <- sample(c("PFS", "PD"), 1, prob = prob_start)
    
    # Simulate trajectory with higher-order dependence
    cont_traj <- sim_one_patient_ho(
      patient_id = i, 
      params = params, 
      tmax = K, 
      start_state = start_state,
      psi = psi,
      phi = phi
    )
    
    # Convert to discrete time chain
    states <- sur_traj(cont_traj, tp)
    
    # Store as data frame
    discrete_chains[[i]] <- data.frame(
      PatientID = i,
      Time = tp,
      State = states
    )
    
    setTxtProgressBar(pb, i)
  }
  
  close(pb)
  
  end_time <- Sys.time()
  cat("\nCompleted in", round(end_time - start_time, 2), "seconds\n")
  
  # Convert to wide format: n rows, (K+1) columns
  # Column 1: initial state, Columns 2:(K+1): states at t=0,1,...,K
  wide_data <- do.call(rbind, lapply(discrete_chains, function(df) {
    # Convert states to numeric: PFS=1, PD=2, Death=3
    state_num <- as.numeric(factor(df$State, 
                                   levels = c("PFS", "PD", "Death"),
                                   labels = c(1, 2, 3)))
    # Row: initial state + states at all time points
    row_vec <- c(state_num[1], state_num)  # first element = initial state
    names(row_vec) <- c("init_state", paste0("t_", tp))
    return(row_vec)
  }))
  
  wide_data <- as.data.frame(wide_data)
  
  return(wide_data)
}

