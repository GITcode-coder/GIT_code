#8. zbic function
zw_mse <- function(y_true, y_pred, tau = log(1.25)) {
  w <- exp(- (y_true^2) / (2 * tau^2))
  mse <- sum(w * (y_true - y_pred)^2,na.rm=T) / sum(w)
  return(mse)
}
zbic<-function(y_true, y_pred, n_parm){
  n<-length(y_true)
  zbic_values <- n*log(zw_mse(y_true, y_pred,tau = log(1.25))) + 2 * n_parm
  return(zbic_values)
}

