t_test_ci_mae <- function(x, y) {
  d <- abs(x-y)
  d <- d[!is.na(d)]
  if (length(d) < 2) {
    return("(NA,NA)")
  }
  
  if (sd(d) < 1e-10) {
    val <- sprintf("%.2f", mean(d))
    return(paste0("(", val, ",", val, ")"))
  }
  
 result <- tryCatch({
    ci <- t.test(d)$conf.int
    paste0("(", sprintf("%.2f", ci[1]), ",", sprintf("%.2f", ci[2]), ")")
  }, error = function(e) {
    "(NA,NA)"
  })
  
  return(result)
}
t_test_ci_mse <- function(x, y) {
